PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=gyanvaniai_admin
SESSION_SECRET=your_secure_session_secret
CSRF_SECRET=your_secure_csrf_secret
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5173,http://127.0.0.1:3000
INITIAL_ADMIN_EMAIL=contact@gyanvaniai.com
INITIAL_ADMIN_PASSWORD=your_admin_password
INITIAL_ADMIN_NAME=GyanVani Super Admin

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_URL=your_cloudinary_url
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS SES / Gmail SMTP Email Transport Configuration
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="GyanVaniAi"
SMTP_FROM_EMAIL=contact@gyanvaniai.com
ADMIN_NOTIFICATION_EMAIL=contact@gyanvaniai.com

# Portfolio Channel Email Configuration
# Using verified AWS SES identity for sending; Reply-To is set to hkbharti77@gmail.com
PORTFOLIO_FROM_EMAIL=no-reply@hkbharti77.website
PORTFOLIO_ADMIN_EMAIL=hkbharti77@gmail.com
PUBLIC_PORTFOLIO_URL=https://hkbharti77.website
# Redis Infrastructure (Voroa / Local)
REDIS_URL=redis://default:your_redis_password@your_redis_host:port/0?sslmode=require
RATE_LIMIT_STORAGE=redis
ENABLE_REDIS_CACHE=true
